        "model_save_extension" : "h5"
    },

    "contract" :{
        "model_contract_path" : "/content/drive/MyDrive/GalaxyClassificationModels/",
        "model_contract_name" : "galassifier_model_contract",
        "model_contract_extension" : "json",
        "release_contract" : true
    },

    "training_stages" :
    {
        "load_and_mount_remote_dataset" : false,
        "mount_remote_images" : true,
        "load_already_built_model" : false,
        "prepare_dataset" : false,
        "train_model" : true,
        "evaluate_model" : true,
