        "convo2d_activation" : "relu"
    },

    "classification" : {
        "classes" :  ["Uncertain", "Spiral", "Elliptical"],
        "keyword_search_for_classes_in_data" : ["U", "S", "E"]
    },

    "data" : {
        "dataset_path" : "",
        "use_validation_set" : true,
        "dataset_split_ratio" : 0.7,
        "dataset_website_source" : "https://www.galaxyzoo.org/",
