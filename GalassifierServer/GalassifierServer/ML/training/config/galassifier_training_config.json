{
    "config_name" : "galassifier-training-pipeline",
    "description" : "This json file is used to configure our training project and pipeline",
    
    "code" : {
        "use_legacy_code" : false,
        "code_additional_notes" : "The legacy code is the code that was used in the previous version of the project. It is kept for reference and comparison purposes. The legacy code is not used in the current version of the project, but can be actiavted by setting this flag to true."
    },

    "storage": {
     "storage_root": "/content/drive/MyDrive/",
     "model_root": "GalaxyClassificationModels/",
     "dataset_root": "Galaxies_Zoo/"
    },

    "model" : {
        "input_image_size" : [28, 28],
        "kernel_size_levels" : [3, 3],
        "num_filters_levels" : [32, 64],
        "maxpool_size_levels" : [2, 2],
        "use_rgb_input" : false,
        "model_additional_notes" : "Up to 3 convo and maxpool layers employable for this project",
        "optimizer" : "adam",
        "metrics" : ["accuracy"],
        "dense_activation" : "softmax",
        "convo2d_activation" : "relu"
    },

    "classification" : {
        "classes" :  ["Uncertain", "Spiral", "Elliptical"],
        "keyword_search_for_classes_in_data" : ["U", "S", "E"],
        "classification_additional_notes" : " 0 = Uncertain, 1 = Spiral, 2 = Elliptical"
    },

    "data" : {
        "dataset_file_path" : "galaxy_dataset.npz",
        "dataset_file_url" : "https://zenodo.org/record/3565489/files/galaxy_dataset.npz",
        "dataset_csv_url" : "https://gz2hart.s3.amazonaws.com/gz2_hart16.csv.gz",
        "dataset_csv_filename" : "gz2_hart16.csv.gz",
        "dataset_images_filename" : "images_gz2_v2.zip",
        "dataset_images_url" : "https://zenodo.org/record/3565489/files/images_gz2_v2.zip",
        "dataset_mapping_filename" : "gz2_filename_mapping.csv",
        "dataset_mapping_url" : "https://zenodo.org/records/3565489/files/gz2_filename_mapping.csv",
        "use_validation_set" : true,
        "dataset_split_ratio" : 0.7,
        "dataset_website_source" : "https://www.galaxyzoo.org/",
        "dataset_additional_notes" : "The dataset is sourced from the Galaxy Zoo project, which is a citizen science project that aims to classify galaxies based on their shapes. The dataset contains images of galaxies that have been labeled by people."
    },

    "training" : {
        "batch_size" : 32,
        "num_epochs" : 50,
        "learning_rate" : 0.001,
        "use_early_stopping" : true,
        "early_stopping_patience" : 3,
        "use_k_fold_cross_validation" : false,
        "train_sample_fraction": 0.5,
        "validation_sample_fraction": 0.5,
        "notes" : "train sample fraction and validation samplem fraction are used to sample a fraciton of the traning and validation data, to save memory and limited resources"
    },

    "evaluation" : {
        "base_shift" : 5,
        "test_size" : 200,
        "use_validation_confusion_matrix" : true,
        "use_debug_plots" : true
    },

    "contract" :{
        "release_contract" : true
    },

    "training_stages" :
    {
        "load_and_mount_remote_dataset" : false,
        "mount_remote_images" : true,
        "load_already_built_model" : false,
        "prepare_dataset" : false,
        "train_model" : true,
        "evaluate_model" : true,
        "save_model" : true, 
        "promote_model" : false,
        "notes" : "Save model is now not used, leaving it only for legacy purposes"
    },

    "run" :
    {
        "run_foldername" : "galassifier_training_run_v",
        "run_version_number" : 1,
        "run_artifact_extension" : "json",
        "run_model_file_extension" : "h5",
        "run_model_name" : "galassifier_model_v",
        "run_checkpoint_name" : "galassifier_model_checkpoint_v",
        "run_model_contract_name" : "galassifier_model_contract_v",
        "run_validation_evaluation_name" : "galassifier_model_val_evaluation_v",
        "run_model_metrics_name" : "galassifier_model_metrics_v",
        "notes" : "This is the file that will be used to save the run information, including the model version number, the training stages, and the evaluation results."
    }
}
